 #include "keyboard.h"
 #include "config.h"
@@ -80,6 +83,10 @@ static enum { DOCK_FULL = 0, DOCK_LEFT = 1, DOCK_RIGHT = 2 } dock_mode = DOCK_FU
 static uint8_t bg_alpha = 0;
