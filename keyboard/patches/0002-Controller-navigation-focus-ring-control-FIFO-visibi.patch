diff --git a/keyboard.c b/keyboard.c
index ea3be7e..12efc5a 100644
--- a/keyboard.c
+++ b/keyboard.c
@@ -2,6 +2,7 @@
 #include <linux/input-event-codes.h>
 #include <stddef.h>
 #include <stdio.h>
