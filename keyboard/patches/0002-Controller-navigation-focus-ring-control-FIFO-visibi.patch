 #include <sys/mman.h>
 #include <ctype.h>
 #include <time.h>
@@ -414,9 +415,252 @@ kbd_motion_key(struct kbd *kb, uint32_t time, uint32_t x, uint32_t y)
     kbd_clear_last_popup(kb);
