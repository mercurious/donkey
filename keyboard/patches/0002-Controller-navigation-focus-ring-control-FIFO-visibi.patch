+            set_kbd_colors(keyboard.focus_color.bgra, argv[++i]);
         } else if ((!strcmp(argv[i], "-wayland-layer")) ||
                    (!strcmp(argv[i], "--wayland-layer"))) {
             if (i >= argc - 1) {
@@ -1271,7 +1382,7 @@ main(int argc, char **argv)
     if (!hidden)
         show();
 
-    struct pollfd fds[2];
+    struct pollfd fds[3];
     int WAYLAND_FD = 0;
     int SIGNAL_FD = 1;
     fds[WAYLAND_FD].events = POLLIN;
@@ -1297,9 +1408,27 @@ main(int argc, char **argv)
         die("Failed to get signalfd: %d\n", errno);
     }
 
+    int CONTROL_FD = 2;
+    fds[CONTROL_FD].events = POLLIN;
+    fds[CONTROL_FD].fd = -1;
+    if (control_path) {
+        unlink(control_path);
+        if (mkfifo(control_path, 0600) == -1) {
+            die("Failed to create control FIFO %s: %d\n", control_path, errno);
+        }
+        // Read-write so the FIFO never reports end-of-file between writers.
+        fds[CONTROL_FD].fd = open(control_path, O_RDWR | O_NONBLOCK);
+        if (fds[CONTROL_FD].fd == -1) {
+            die("Failed to open control FIFO %s: %d\n", control_path, errno);
+        }
+    }
+    if (hook_cmd)
+        signal(SIGCHLD, SIG_IGN); // hooks are fire-and-forget; reap them
+    bool hook_hidden = hidden;
+
     while (run_display) {
         wl_display_flush(display);
-        poll(fds, 2, -1);
+        poll(fds, 3, -1);
 
         if (fds[WAYLAND_FD].revents & POLLIN)
             wl_display_dispatch(display);
@@ -1324,6 +1453,14 @@ main(int argc, char **argv)
             else if (si.ssi_signo == SIGPIPE)
                 pipewarn();
         }
+
+        if (fds[CONTROL_FD].fd != -1 && (fds[CONTROL_FD].revents & POLLIN))
+            control_read(fds[CONTROL_FD].fd);
+
+        if (hook_cmd && hook_hidden != hidden) {
+            hook_hidden = hidden;
+            run_hook(hidden ? "hide" : "show");
+        }
     }
 
     if (fc_font_pattern) {
@@ -1332,5 +1469,8 @@ main(int argc, char **argv)
             schemes[i].font = NULL;
     }
 
+    if (control_path)
+        unlink(control_path);
+
     return 0;
 }
