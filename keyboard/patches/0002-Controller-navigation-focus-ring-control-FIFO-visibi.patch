 }
 
+static void
+run_hook(const char *event)
+{
+    pid_t pid = fork();
+    if (pid == 0) {
+        execl("/bin/sh", "sh", "-c", "exec $0 \"$1\"", hook_cmd, event,
+              (char *)NULL);
+        _exit(127);
+    }
+    if (pid == -1)
+        fprintf(stderr, "wvkbd: hook fork failed: %d\n", errno);
+}
+
+static void
+control_command(const char *cmd)
+{
+    if (!strcmp(cmd, "show")) {
+        show();
+        return;
+    }
+    if (!strcmp(cmd, "hide")) {
+        hide();
+        return;
+    }
+    if (!strcmp(cmd, "toggle")) {
+        toggle_visibility();
+        return;
+    }
+    if (hidden || !layer_surface_configured)
+        return;
+
+    if (!strcmp(cmd, "up"))
+        kbd_focus_move(&keyboard, 0, -1);
+    else if (!strcmp(cmd, "down"))
+        kbd_focus_move(&keyboard, 0, 1);
+    else if (!strcmp(cmd, "left"))
+        kbd_focus_move(&keyboard, -1, 0);
+    else if (!strcmp(cmd, "right"))
+        kbd_focus_move(&keyboard, 1, 0);
+    else if (!strcmp(cmd, "press"))
+        kbd_focus_press(&keyboard);
+    else if (!strcmp(cmd, "shift"))
+        kbd_toggle_mod(&keyboard, Shift);
+    else if (!strcmp(cmd, "layer"))
+        kbd_next_layer(&keyboard, NULL, false);
+    else if (!strcmp(cmd, "backspace"))
+        kbd_tap_code(&keyboard, KEY_BACKSPACE);
+    else if (!strcmp(cmd, "enter"))
+        kbd_tap_code(&keyboard, KEY_ENTER);
+    else if (!strcmp(cmd, "space"))
+        kbd_tap_code(&keyboard, KEY_SPACE);
+    else if (!strcmp(cmd, "cursor-left"))
+        kbd_tap_code(&keyboard, KEY_LEFT);
+    else if (!strcmp(cmd, "cursor-right"))
+        kbd_tap_code(&keyboard, KEY_RIGHT);
+    else
+        fprintf(stderr, "wvkbd: unknown control command '%s'\n", cmd);
+}
+
+static void
+control_read(int fd)
+{
+    static char buf[256];
+    static size_t len = 0;
+    ssize_t n;
+    while ((n = read(fd, buf + len, sizeof(buf) - 1 - len)) > 0) {
+        len += n;
+        char *start = buf, *nl;
+        while ((nl = memchr(start, '\n', buf + len - start))) {
+            *nl = '\0';
+            if (nl > start)
+                control_command(start);
+            start = nl + 1;
+        }
+        len = buf + len - start;
+        memmove(buf, start, len);
+        if (len == sizeof(buf) - 1)
+            len = 0; // an over-long line: drop it
+    }
+}
+
 void
 pipewarn()
 {
@@ -925,6 +1017,7 @@ main(int argc, char **argv)
     keyboard.corner_radius = 0;
     keyboard.show_popup = true;
