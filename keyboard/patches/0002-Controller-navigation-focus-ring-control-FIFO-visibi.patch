+/* Donkey: a FIFO of line commands for controller navigation, and a command
+ * run with "show" or "hide" whenever visibility changes. */
+static char *control_path = NULL;
+static char *hook_cmd = NULL;
 
 
 
@@ -688,6 +695,9 @@ usage(char *argv0)
         stderr,
         "  --alpha [int]          - Set alpha value for all colors [0-255]\n");
     fprintf(stderr, "  --auto                 - Automatically toggle visibility based on focus\n");
+    fprintf(stderr, "  --control [path]       - Read navigation commands from a FIFO at path\n");
+    fprintf(stderr, "  --hook [command]       - Run 'command show|hide' when visibility changes\n");
+    fprintf(stderr, "  --focus [rrggbb|aa]    - Set color of the controller focus ring\n");
     fprintf(stderr, "  --bg [rrggbb|aa]       - Set color of background\n");
     fprintf(stderr, "  --fg [rrggbb|aa]       - Set color of keys\n");
     fprintf(stderr, "  --fg-sp [rrggbb|aa]    - Set color of special keys\n");
@@ -799,6 +809,7 @@ show()
 
     refresh_available_dimension();
