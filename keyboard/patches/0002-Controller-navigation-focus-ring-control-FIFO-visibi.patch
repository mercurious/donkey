+/* Width of the controller focus ring, in surface pixels. */
+#define KBD_FOCUS_RING 5
+
+static bool
+kbd_key_focusable(const struct key *k)
+{
+    return (k->type != Pad) && (k->type != EndRow) && (k->type != Last) &&
+           (k->w > 0);
+}
+
+static bool
+kbd_layout_has_key(const struct layout *l, const struct key *k)
+{
+    if (!k)
+        return false;
+    for (const struct key *it = l->keys; it->type != Last; it++) {
+        if (it == k)
+            return true;
+    }
+    return false;
+}
+
+static int32_t
+kbd_key_cx(const struct key *k)
+{
+    return (int32_t)(k->x + k->w / 2);
+}
+
+static int32_t
+kbd_key_cy(const struct key *k)
+{
+    return (int32_t)(k->y + k->h / 2);
+}
+
+/* The focusable key in the current layout whose centre is nearest (x, y). */
+static struct key *
+kbd_nearest_key(struct kbd *kb, int32_t x, int32_t y)
+{
+    struct key *best = NULL;
+    int64_t best_d = 0;
+    for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+        if (!kbd_key_focusable(k))
+            continue;
+        int64_t dx = kbd_key_cx(k) - x, dy = kbd_key_cy(k) - y;
+        int64_t d = dx * dx + dy * dy;
+        if (!best || d < best_d) {
+            best = k;
+            best_d = d;
+        }
+    }
+    return best;
+}
+
+/* Draw a key in its resting state: pressed look for latched modifiers,
+ * plain otherwise. kbd_draw_key adds the ring when it is the focus. */
+static void
+kbd_redraw_key(struct kbd *kb, struct key *k)
+{
+    if ((k->type == Mod && (kb->mods & k->code)) ||
+        (k->type == Compose && kb->compose)) {
+        kbd_draw_key(kb, k, Press);
+    } else {
+        kbd_draw_key(kb, k, None);
+    }
+}
+
+static void
+kbd_set_focus(struct kbd *kb, struct key *k)
+{
+    struct key *old = kb->focus;
+    kb->focus = k;
+    if (old && old != k && kbd_layout_has_key(kb->layout, old))
+        kbd_redraw_key(kb, old);
+    if (k)
+        kbd_redraw_key(kb, k);
+}
+
+/* Keep the ring on the current layout after a layer switch or resize: land
+ * on whatever key now sits where the ring was. */
+static void
+kbd_focus_follow(struct kbd *kb)
+{
+    if (!kb->focus || kbd_layout_has_key(kb->layout, kb->focus))
+        return;
+    kb->focus = kbd_nearest_key(kb, kbd_key_cx(kb->focus),
+                                kbd_key_cy(kb->focus));
+    if (kb->focus)
+        kb->focus_column = kbd_key_cx(kb->focus);
+}
+
+void
+kbd_focus_reset(struct kbd *kb)
+{
+    /* Start in the middle of the letters, where most words begin. */
+    struct key *k = kbd_nearest_key(kb, kb->w / 2, kb->h / 2);
+    if (k)
+        kb->focus_column = kbd_key_cx(k);
+    kbd_set_focus(kb, k);
+}
+
+void
+kbd_focus_move(struct kbd *kb, int dx, int dy)
+{
+    struct key *f = kb->focus;
+    if (!kbd_layout_has_key(kb->layout, f)) {
+        kbd_focus_reset(kb);
+        return;
+    }
+    int32_t fx = kbd_key_cx(f);
+    struct key *best = NULL;
+    int64_t best_score = 0;
+
+    if (dx) {
+        /* Along the row; past the end wraps to the other end. */
+        for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+            if (!kbd_key_focusable(k) || k == f || k->y != f->y)
+                continue;
+            int64_t d = (int64_t)(kbd_key_cx(k) - fx) * dx;
+            if (d > 0 && (!best || d < best_score)) {
+                best = k;
+                best_score = d;
+            }
+        }
+        if (!best) {
+            for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+                if (!kbd_key_focusable(k) || k == f || k->y != f->y)
+                    continue;
+                int64_t d = (int64_t)(fx - kbd_key_cx(k)) * dx;
+                if (d > 0 && (!best || d > best_score)) {
+                    best = k;
+                    best_score = d;
+                }
+            }
+        }
+        if (best)
+            kb->focus_column = kbd_key_cx(best);
+    } else if (dy) {
+        /* Pick the next row in that direction (wrapping), then the key in
+         * it under the remembered column, so a trip through the wide space
+         * bar comes back to the same letter. */
+        bool found = false;
+        uint32_t row_y = 0;
+        int64_t row_d = 0;
+        for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+            if (!kbd_key_focusable(k))
+                continue;
+            int64_t d = ((int64_t)k->y - f->y) * dy;
+            if (d > 0 && (!found || d < row_d)) {
+                found = true;
+                row_y = k->y;
+                row_d = d;
+            }
+        }
+        if (!found) {
+            for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+                if (!kbd_key_focusable(k))
+                    continue;
+                int64_t d = ((int64_t)f->y - k->y) * dy;
+                if (d > 0 && (!found || d > row_d)) {
+                    found = true;
+                    row_y = k->y;
+                    row_d = d;
+                }
+            }
+        }
+        if (found) {
+            int32_t col = kb->focus_column;
+            for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+                if (!kbd_key_focusable(k) || k->y != row_y)
+                    continue;
+                if (col >= (int32_t)k->x && col < (int32_t)(k->x + k->w)) {
+                    best = k;
+                    break;
+                }
+                int64_t d = llabs((int64_t)kbd_key_cx(k) - col);
+                if (!best || d < best_score) {
+                    best = k;
+                    best_score = d;
+                }
+            }
+        }
+    }
+
+    if (best)
+        kbd_set_focus(kb, best);
+}
+
+void
+kbd_focus_press(struct kbd *kb)
+{
+    if (!kbd_layout_has_key(kb->layout, kb->focus)) {
+        kbd_focus_reset(kb);
+        return;
+    }
+    uint32_t time = (uint32_t)monotime();
+    kbd_unpress_key(kb, time);
+    kbd_press_key(kb, kb->focus, time);
+    kbd_release_key(kb, time);
+    /* A layer key may have swapped the layout under the ring. */
+    if (!kbd_layout_has_key(kb->layout, kb->focus)) {
+        kbd_focus_follow(kb);
+        kbd_draw_layout(kb);
+    } else {
+        kbd_redraw_key(kb, kb->focus);
+    }
+}
+
+void
+kbd_tap_code(struct kbd *kb, uint32_t code)
+{
+    uint32_t time = (uint32_t)monotime();
+    zwp_virtual_keyboard_v1_modifiers(kb->vkbd, kb->mods, 0, 0, 0);
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code,
+                                WL_KEYBOARD_KEY_STATE_PRESSED);
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code,
+                                WL_KEYBOARD_KEY_STATE_RELEASED);
+}
+
+void
+kbd_toggle_mod(struct kbd *kb, uint32_t mod)
+{
+    /* Press the layout's own key for that modifier so latching and the
+     * shifted labels behave exactly as a tap on it would. */
+    for (struct key *k = kb->layout->keys; k->type != Last; k++) {
+        if (k->type == Mod && k->code == mod) {
+            uint32_t time = (uint32_t)monotime();
+            kbd_press_key(kb, k, time);
+            kbd_release_key(kb, time);
+            return;
+        }
+    }
+}
+
 void
 kbd_press_key(struct kbd *kb, struct key *k, uint32_t time)
 {
+    /* Once the controller has shown the ring, a tap moves it too, so the
+     * two input methods never disagree about where you are. */
+    if (kb->focus && k != kb->focus && kbd_layout_has_key(kb->layout, k)) {
+        struct key *old = kb->focus;
+        kb->focus = k;
+        kb->focus_column = kbd_key_cx(k);
+        if (kbd_layout_has_key(kb->layout, old))
+            kbd_redraw_key(kb, old);
+    }
+
     if ((kb->compose == 1) && (k->type != Compose) && (k->type != Mod)) {
         if ((k->type == NextLayer) || (k->type == BackLayer) ||
             ((k->type == Code) && (k->code == KEY_SPACE))) {
@@ -653,8 +897,16 @@ kbd_draw_key(struct kbd *kb, struct key *k, enum key_draw_type type)
     switch (type) {
     case None:
     case Unpress:
-        draw_inset(kb->surf, k->x, k->y, k->w, k->h, KBD_KEY_BORDER,
-                   scheme->fg, scheme->rounding);
+        if (k == kb->focus) {
+            draw_inset(kb->surf, k->x, k->y, k->w, k->h, KBD_KEY_BORDER,
+                       kb->focus_color, scheme->rounding);
+            draw_inset(kb->surf, k->x, k->y, k->w, k->h,
+                       KBD_KEY_BORDER + KBD_FOCUS_RING, scheme->fg,
+                       scheme->rounding);
+        } else {
+            draw_inset(kb->surf, k->x, k->y, k->w, k->h, KBD_KEY_BORDER,
+                       scheme->fg, scheme->rounding);
+        }
         drw_draw_text(kb->surf, scheme->text, k->x, k->y, k->w, k->h,
                   KBD_KEY_BORDER, label, scheme->font_description);
         break;
@@ -704,6 +956,7 @@ void
 kbd_draw_layout(struct kbd *kb)
 {
     struct drwsurf *d = kb->surf;
+    kbd_focus_follow(kb);
     struct key *next_key = kb->layout->keys;
     if (kb->debug)
         fprintf(stderr, "Draw layout\n");
diff --git a/keyboard.h b/keyboard.h
